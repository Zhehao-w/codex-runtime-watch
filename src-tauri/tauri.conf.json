{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Runtime Watch",
  "version": "0.1.0",
  "identifier": "dev.codexruntimewatch.app",
  "build": { "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build", "devUrl": "http://localhost:1420", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Codex Runtime Watch", "width": 560, "height": 720, "minWidth": 420, "resizable": true }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": true, "targets": ["app", "dmg", "msi", "nsis"], "icon": [] }
}
